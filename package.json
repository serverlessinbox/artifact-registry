{
  "name": "artifact-registry-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "yarn@4.15.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "test": "yarn workspaces foreach --all run test",
    "lint": "eslint packages/*/src",
    "lint:all": "eslint packages/*/src --max-warnings=-1"
  },
  "devDependencies": {
    "@jwpkg/gitversion": "1.4.0-pack-order.2",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
