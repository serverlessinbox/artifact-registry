{
  "name": "@serverlessinbox/artifact-registry",
  "version": "0.0.0",
  "description": "S3-backed artifact registry: versioned artifact publishing and channel-based version resolution",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": "dist/cli-entry.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src",
    "lint:all": "eslint src --max-warnings=-1",
    "build": "tsc --noEmit false",
    "test": "jest",
    "prepublishOnly": "yarn build"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "packageManager": "yarn@4.15.0",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "clipanion": "^3.2.1",
    "esbuild": "^0.27.1",
    "semver": "^7.8.1",
    "typanion": "^3.14.0"
  },
  "devDependencies": {
    "@jwpkg/gitversion": "1.4.0-pack-order.2",
    "@types/aws-lambda": "^8.10.141",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/semver": "^7.7.1",
    "aws-sdk-client-mock": "^4",
    "eslint": "^9",
    "jest": "^29",
    "jest-util": "^29",
    "ts-jest": "^29",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "peerDependencies": {
    "@jwpkg/gitversion": "1.4.0-pack-order.2"
  }
}
