{
  "name": "@serverlessinbox/artifact-registry-gitversion",
  "version": "0.0.0",
  "description": "gitversion plugin that packs and publishes the artifacts of a workspace to an S3 artifact registry",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit false",
    "test": "jest",
    "prepublishOnly": "yarn build"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serverlessinbox/artifact-registry.git",
    "directory": "packages/artifact-registry-gitversion"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@serverlessinbox/artifact-registry": "workspace:^",
    "semver": "^7.8.1",
    "typanion": "^3.14.0"
  },
  "devDependencies": {
    "@jwpkg/gitversion": "1.4.0-pack-order.2",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/semver": "^7.7.1",
    "aws-sdk-client-mock": "^4",
    "jest": "^29",
    "jest-util": "^29",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@jwpkg/gitversion": "^1.4.0-pack-order.2"
  }
}
