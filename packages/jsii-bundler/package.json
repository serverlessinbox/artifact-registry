    "@types/node": "^24.10.1",
    "esbuild": "^0.27.1",
    "jest": "^29",
    "jest-util": "^29",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "esbuild": "^0.27.1"
  }
}
