{
  "name": "@serverlessinbox/jsii-bundler",
  "version": "0.0.0",
  "description": "esbuild bundler for jsii CDK construct libraries and Lambda zips",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serverlessinbox/artifact-registry.git",
    "directory": "packages/jsii-bundler"
  },
  "private": true,
  "main": "src/index.ts",
